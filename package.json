{
  "name": "geosimples-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/geosimples",
    "build": "npm run build -w apps/geosimples",
    "test": "npm test -w packages/core",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w apps/geosimples && tsc -p e2e",
    "lint": "eslint .",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.4"
  }
}
