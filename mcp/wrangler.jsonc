{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "geosimples-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "upload_source_maps": true,
  // Keep the *.workers.dev address for testing; the public one is the custom domain.
  "workers_dev": true,
  "routes": [{ "pattern": "geosimples.mcp.dandes.dev", "custom_domain": true }],
  "vars": {
    "SITE_URL": "https://geosimples.vercel.app/"
  },
  "ratelimits": [
    {
      // Per client IP and Cloudflare location. Generous, since claude.ai calls from a few shared addresses.
      "name": "LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
